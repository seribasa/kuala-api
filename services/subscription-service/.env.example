# Subscription Service Environment Variables Example
# Copy this file to .env and update the values for your environment

# =============================================================================
# RABBITMQ CONFIGURATION
# =============================================================================

# RabbitMQ connection URL
# Docker Compose service name: rabbitmq
# Format: amqp://[user]:[password]@[host]:[port]
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672

# Use polling fallback if RabbitMQ is unavailable
RABBITMQ_FALLBACK=false

# Polling interval in ms (used when RABBITMQ_FALLBACK=true)
POLLING_INTERVAL=5000

# =============================================================================
# KILL BILL CONFIGURATION
# =============================================================================

# Kill Bill server base URL
# Docker Compose service name: killbill
KILLBILL_BASE_URL=http://killbill:8080

# Kill Bill tenant API credentials
KILLBILL_API_KEY=demo
KILLBILL_API_SECRET=demosecret

# Kill Bill admin credentials
KILLBILL_USERNAME=admin
KILLBILL_PASSWORD=password

# Default currency for new subscriptions
KILLBILL_DEFAULT_CURRENCY=USD

# =============================================================================
# SUPABASE CONFIGURATION
# =============================================================================

# Supabase project URL (for subscription state management)
SUPABASE_URL=http://host.docker.internal:54321
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# =============================================================================
# AUTH CONFIGURATION (for JWT validation)
# =============================================================================
AUTH_BASE_URL=https://your-project-id.supabase.co
AUTH_SUPABASE_ANON_KEY=your_supabase_anon_key_here
