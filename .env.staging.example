# Kuala API - Staging Environment Variables
# Copy this file to .env for staging deployment

# =============================================================================
# KONG API GATEWAY
# =============================================================================
KONG_GATEWAY_URL=https://api-staging.your-domain.com
KONG_ADMIN_URL=https://kong-admin-staging.your-domain.com

# =============================================================================
# SUPABASE CONFIGURATION (Staging Project)
# =============================================================================
SUPABASE_URL=https://your-staging-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-staging-service-role-key
AUTH_BASE_URL=https://your-staging-project.supabase.co
AUTH_SUPABASE_ANON_KEY=your-staging-anon-key

# =============================================================================
# KEYCLOAK CONFIGURATION (Staging)
# =============================================================================
EXTERNAL_KEYCLOAK_ENABLED=true
EXTERNAL_KEYCLOAK_CLIENT_ID=kuala
EXTERNAL_KEYCLOAK_SECRET=your-staging-keycloak-secret
EXTERNAL_KEYCLOAK_REDIRECT_URI=https://staging.your-domain.com/auth/callback
EXTERNAL_KEYCLOAK_URL=https://identity-staging.your-domain.com/realms/kuala

# =============================================================================
# KILL BILL CONFIGURATION (Staging)
# =============================================================================
KILLBILL_BASE_URL=https://billing-staging.your-domain.com
KILLBILL_API_KEY=your-staging-api-key
KILLBILL_API_SECRET=your-staging-api-secret
KILLBILL_USERNAME=your-staging-admin-user
KILLBILL_PASSWORD=your-staging-admin-password
KILLBILL_DEFAULT_CURRENCY=USD

# =============================================================================
# RABBITMQ CONFIGURATION (Managed - CloudAMQP recommended)
# =============================================================================
RABBITMQ_URL=amqps://user:password@staging-rabbitmq.cloudamqp.com/vhost

# =============================================================================
# ENTERPRISE CONTACT CONFIGURATION
# =============================================================================
ENTERPRISE_CONTACT_EMAIL=staging@your-domain.com
ENTERPRISE_CONTACT_PHONE=+1-555-0123
ENTERPRISE_CONTACT_MESSAGE="Contact us for enterprise pricing"

# =============================================================================
# CORS CONFIGURATION
# =============================================================================
CORS_ENABLED=true
CORS_ORIGIN=https://staging.your-domain.com,https://app-staging.your-domain.com

# =============================================================================
# LOGGING & DEBUG
# =============================================================================
LOG_LEVEL=info
DEBUG=false
