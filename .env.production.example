# Kuala API - Production Environment Variables
# Copy this file to .env for production deployment
# 
# ⚠️  SECURITY WARNING: Never commit actual production values to version control
# Use environment injection from your deployment platform (K8s secrets, Docker secrets, etc.)

# =============================================================================
# KONG API GATEWAY
# =============================================================================
KONG_GATEWAY_URL=https://api.your-domain.com
KONG_ADMIN_URL=https://kong-admin.your-domain.com

# =============================================================================
# SUPABASE CONFIGURATION (Production Project)
# =============================================================================
SUPABASE_URL=https://your-production-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-production-service-role-key
AUTH_BASE_URL=https://your-production-project.supabase.co
AUTH_SUPABASE_ANON_KEY=your-production-anon-key

# =============================================================================
# KEYCLOAK CONFIGURATION (Production)
# =============================================================================
EXTERNAL_KEYCLOAK_ENABLED=true
EXTERNAL_KEYCLOAK_CLIENT_ID=kuala
EXTERNAL_KEYCLOAK_SECRET=your-production-keycloak-secret
EXTERNAL_KEYCLOAK_REDIRECT_URI=https://your-domain.com/auth/callback
EXTERNAL_KEYCLOAK_URL=https://identity.your-domain.com/realms/kuala

# =============================================================================
# KILL BILL CONFIGURATION (Production)
# =============================================================================
KILLBILL_BASE_URL=https://billing.your-domain.com
KILLBILL_API_KEY=your-production-api-key
KILLBILL_API_SECRET=your-production-api-secret
KILLBILL_USERNAME=your-production-admin-user
KILLBILL_PASSWORD=your-production-admin-password
KILLBILL_DEFAULT_CURRENCY=USD

# =============================================================================
# RABBITMQ CONFIGURATION (Production Cluster)
# =============================================================================
RABBITMQ_URL=amqps://user:password@production-rabbitmq.cloudamqp.com/vhost

# =============================================================================
# ENTERPRISE CONTACT CONFIGURATION
# =============================================================================
ENTERPRISE_CONTACT_EMAIL=enterprise@your-domain.com
ENTERPRISE_CONTACT_PHONE=+1-555-ENTERPRISE
ENTERPRISE_CONTACT_MESSAGE="Contact our enterprise sales team for custom solutions"

# =============================================================================
# CORS CONFIGURATION
# =============================================================================
CORS_ENABLED=true
CORS_ORIGIN=https://your-domain.com,https://app.your-domain.com

# =============================================================================
# LOGGING & DEBUG
# =============================================================================
LOG_LEVEL=warn
DEBUG=false
