# Kuala API - Development Environment Variables
# Copy this file to .env for local development

# =============================================================================
# KONG API GATEWAY
# =============================================================================
KONG_GATEWAY_URL=http://localhost:8000
KONG_ADMIN_URL=http://localhost:8001

# =============================================================================
# SUPABASE CONFIGURATION (Local)
# =============================================================================
SUPABASE_URL=http://localhost:54321
SUPABASE_SERVICE_ROLE_KEY=your-local-service-role-key
AUTH_BASE_URL=http://localhost:54321
AUTH_SUPABASE_ANON_KEY=your-local-anon-key

# =============================================================================
# KEYCLOAK CONFIGURATION (Local)
# =============================================================================
EXTERNAL_KEYCLOAK_ENABLED=true
EXTERNAL_KEYCLOAK_CLIENT_ID=kuala
EXTERNAL_KEYCLOAK_SECRET=your-local-keycloak-secret
EXTERNAL_KEYCLOAK_REDIRECT_URI=http://localhost:3000/auth/callback
EXTERNAL_KEYCLOAK_URL=http://localhost:7080/realms/kuala

# =============================================================================
# KILL BILL CONFIGURATION (Local)
# =============================================================================
KILLBILL_BASE_URL=http://localhost:8080
KILLBILL_API_KEY=demo
KILLBILL_API_SECRET=demosecret
KILLBILL_USERNAME=admin
KILLBILL_PASSWORD=password
KILLBILL_DEFAULT_CURRENCY=USD

# =============================================================================
# RABBITMQ CONFIGURATION (Local)
# =============================================================================
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# =============================================================================
# ENTERPRISE CONTACT CONFIGURATION
# =============================================================================
ENTERPRISE_CONTACT_EMAIL=dev@example.com
ENTERPRISE_CONTACT_PHONE=+1-555-0123
ENTERPRISE_CONTACT_MESSAGE="Development environment"

# =============================================================================
# CORS CONFIGURATION
# =============================================================================
CORS_ENABLED=true
CORS_ORIGIN=*

# =============================================================================
# LOGGING & DEBUG
# =============================================================================
LOG_LEVEL=debug
DEBUG=true
