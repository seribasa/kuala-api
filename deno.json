{
	"nodeModulesDir": "auto",
	"npm": {
		"specifiers": []
	},
	"imports": {
		"@hono/zod-validator": "jsr:@hono/zod-validator@^0.9.0",
		"@std/testing": "jsr:@std/testing@^1.0.12",
		"@std/assert": "jsr:@std/assert@^1.0.12",
		"@std/testing/mock": "jsr:@std/testing@^1.0.12/mock",
		"@hono/hono": "jsr:@hono/hono@^4.6.3",
		"@hono/hono/logger": "jsr:@hono/hono@^4.6.3/logger",
		"@supabase/supabase-js": "npm:@supabase/supabase-js@^2.87.1",
		"rabbitmq-client": "npm:rabbitmq-client@^5.0.8",
		"pdf-lib": "npm:pdf-lib@^1.17.1",
		"@shared/": "./supabase/functions/_shared/",
		"zod": "npm:zod@^4.4.3"
	},
	"tasks": {
		"dev": "deno run --allow-net --allow-env --watch=supabase/functions,infra/self-hosted --config=deno.json --env-file=./.env ./infra/self-hosted/server.ts",
		"start": "deno run --allow-net --allow-env --config=deno.json --env-file=./.env ./infra/self-hosted/server.ts",
		"services": "deno run --allow-all --config=deno.json --env-file=./.env ./services/start-all-services.ts",
		"services:dev": "deno run --allow-all --watch=supabase/functions --config=deno.json --env-file=./.env ./services/start-all-services.ts",
		"test": "deno test --allow-net --allow-env --env-file=.env.test --coverage=coverage",
		"lcov": "deno coverage --lcov coverage/ > coverage.lcov",
		"lint": "deno lint"
	},
	"fmt": {
		"useTabs": true,
		"indentWidth": 4,
		"include": [
			"services/",
			"supabase/functions/",
			"infra/self-hosted/"
		],
		"exclude": ["**/node_modules/**", "**/dist/**", "**/coverage/**"]
	},
	"lint": {
		"include": [
			"services/",
			"supabase/functions/",
			"infra/self-hosted/"
		],
		"exclude": ["**/node_modules/**", "**/dist/**", "**/coverage/**"],
		"rules": {
			"tags": ["recommended"],
			"include": ["ban-untagged-todo"],
			"exclude": ["no-unused-vars"]
		}
	},
	"test": {
		"include": [
			"services/",
			"supabase/functions/",
			"infra/self-hosted/"
		],
		"exclude": ["**/node_modules/**", "**/dist/**", "**/coverage/**"]
	}
}
